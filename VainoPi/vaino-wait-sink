#!/bin/sh
# Block until PipeWire has somewhere audible to send audio.
#
# Bluetooth is the slow case: BlueZ has to auto-connect a trusted device after
# the radio comes up, which takes several seconds after the graph is ready.
# Exits 0 regardless -- a player with no speaker should still come up and say
# so in its interface, which is more use than a service that refuses to run.
#
# **`[PI3-FOUND-110]` The gate this replaces never actually held.** Its first
# condition was `... | grep -qv 'Dummy Output'`, read as "a sink that is not
# the dummy exists". `grep -v` succeeds when ANY line fails to match, and the
# block it was fed begins with the `├─ Sinks:` header -- so the condition was
# true on every machine in every state, including one whose only sink was the
# dummy. Measured 2026-09-08 on vainopi, whose HDMI and headphone outputs are
# both switched off at the kernel command line and which therefore has no
# hardware sink at all until Bluetooth arrives: it reported "real sink present
# after 3s" and released the player onto a dummy, 30 s before the speaker
# existed. The player then opened its output onto nothing audible and stayed
# there. Every layer above reported success.
#
# Naming a sink is also not enough on its own: the point of waiting is the
# CHOSEN speaker, and any other real sink satisfying the wait is how the
# player ends up bound to the wrong one. So the speaker gets first refusal,
# and anything real is accepted only once its grace period has passed --
# which keeps a speakerless appliance booting promptly.
# **`[PI3-FOUND-150]` Waiting here is only free until it stops overlapping
# with something.** The player does not touch its output when it starts: it
# backs up listener state, builds the library index -- 8330 passages off a
# 1.1 GB database on a Pi Zero 2W, about twenty seconds -- and only then opens
# a device. So the twenty seconds after `vaino` starts are twenty seconds in
# which Bluetooth may finish settling at no cost at all, and every second
# spent waiting *before* starting it is a second added to the total rather
# than hidden inside it. Measured on a power cycle: this gate waited its full
# 45 s, gave up, and only then let a twenty-second library load begin --
# ninety-five seconds to audio, of which about forty-five were spent
# deliberately doing nothing.
#
# **`[PI3-FOUND-260]` That reasoning was true for about a day, and cutting the
# deadline to 15 s on the strength of it was a mistake.** The twenty seconds
# were never the library load: they were contention, and once `mpd` was made
# to yield `[PI3-FOUND-210]` the same work measured 120 ms. So there is no
# longer a slow start for a wait to hide inside -- the player is ready in
# under two seconds, and every second this gate spends is simply a second of
# waiting.
#
# But waiting is not what it costs. Measured on the boot after the cut: the
# speaker took 63 s to answer (it had been taken by another device
# `[PI3-FOUND-090]`), this gate gave up at 15 s, and the player opened onto a
# dummy and played into it for twenty-seven seconds before `vaino-speaker`
# reconnected and asked for a reopen. That boot recorded 26.45 s of underrun,
# against 2.79 s on a boot where the speaker was present before the player
# started. Starting early buys nothing and costs a reopen; starting late
# costs only silence that was silent anyway.
#
# So the deadline goes back up. It still exits the instant the speaker's sink
# appears -- which on a healthy boot is a few seconds -- and it still gives
# that speaker first refusal over any other. It simply no longer gives up
# early on a machine whose speaker is routinely slow to answer, which is this
# one, by design `[PI3-FOUND-090]`.
set -u
DEADLINE=${VAINO_SINK_WAIT:-60}
SPEAKER_GRACE=${VAINO_SPEAKER_WAIT:-45}
DB="${VAINO_DB:-/srv/library/vaino.db}"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"

# Every sink PipeWire currently offers, one name per line, dummy excluded.
# Parsed from the numbered rows only, so no header or box-drawing line can be
# mistaken for a sink -- the whole of `[PI3-FOUND-110]`.
real_sinks() {
    wpctl status 2>/dev/null |
        sed -n '/Sinks:/,/Sink endpoints/p' |
        sed -n 's/^[^0-9]*[0-9][0-9]*\.[[:space:]]*\(.*\)$/\1/p' |
        sed 's/[[:space:]]*\[vol.*$//; s/[[:space:]]*$//' |
        grep -v '^Dummy Output$'
}

# The speaker the listener chose, by the name PipeWire will give its sink
# [PI3-AIM-020]. Absent is fine and common: it just means anything real will
# do.
WANT=""
ADDR=$(sqlite3 "$DB" \
    "SELECT value FROM player_settings WHERE key = 'speaker_address'" 2>/dev/null)
[ -n "${ADDR:-}" ] && WANT=$(bluetoothctl info "$ADDR" 2>/dev/null |
    sed -n 's/^[[:space:]]*Alias: //p')

i=0
while [ "$i" -lt "$DEADLINE" ]; do
    sinks=$(real_sinks)
    if [ -n "$sinks" ]; then
        if [ -n "$WANT" ] && echo "$sinks" | grep -qxF "$WANT"; then
            echo "vaino-wait-sink: $WANT present after ${i}s"
            exit 0
        fi
        # Something real, but not the speaker. Worth having, but not worth
        # binding to while the speaker may still be seconds away.
        if [ -z "$WANT" ] || [ "$i" -ge "$SPEAKER_GRACE" ]; then
            echo "vaino-wait-sink: real sink present after ${i}s ($(echo "$sinks" | tr '\n' ' '))"
            exit 0
        fi
    fi
    i=$((i + 1))
    sleep 1
done
echo "vaino-wait-sink: no real sink after ${DEADLINE}s; starting anyway" >&2
exit 0
