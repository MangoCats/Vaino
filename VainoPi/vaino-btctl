#!/bin/bash
# The privileged helper for Bluetooth speaker selection [PI-SET-030].
#
# The web process must not hold the privilege to run arbitrary BlueZ commands,
# and it must not be able to smuggle one through an argument. So this is a
# closed set of verbs, each taking at most a device address, with that address
# checked against a strict pattern BEFORE it reaches any command. Nothing here
# is interpolated into a shell.
#
# Invoked as:  sudo /usr/local/bin/vaino-btctl VERB [ADDRESS]
# Output is JSON on stdout, so the caller parses a shape rather than prose.
#
# The verbs exist because of specific failures recorded in PI003 §1:
#   pair    registers an agent first, or the exchange never completes
#   repair  removes a stale record first, or pairing fails with no explanation
#   use     connect + trust + default, because trust is what survives a reboot
set -uo pipefail
export LC_ALL=C

VERB="${1:-}"
ADDR="${2:-}"

die() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 1; }

# Every verb but list and scan needs an address, and it is the only untrusted
# input this program takes. Anchored, fixed length, uppercase hex only: an
# argument that is not exactly a MAC never reaches bluetoothctl.
need_addr() {
    [[ "$ADDR" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] \
        || die "not a device address"
}

# bluetoothctl wants a login session's bus; sudo does not bring one.
RUN_UID="$(id -u "${SUDO_USER:-$USER}")"
export XDG_RUNTIME_DIR="/run/user/$RUN_UID"

# Pairing needs a registered agent for the duration [PI3-WHY-060], and the
# steps need pauses: piping them as one block runs them faster than bluetoothd
# establishes the connection, which is how a pair can report success and leave
# the device unpaired.
pair_sequence() {
    {
        printf 'power on\n';              sleep 2
        printf 'pairable on\n';           sleep 1
        printf 'agent NoInputNoOutput\n'; sleep 1
        printf 'default-agent\n';         sleep 1
        # A speaker is a classic BR/EDR device, and the default discovery
        # filter returns LE only. Without this the Middleton is invisible to
        # every scan -- eight other devices found, and never the one being
        # looked for. It reads like the speaker is switched off.
        printf 'menu scan\n';             sleep 1
        printf 'transport bredr\n';       sleep 1
        printf 'back\n';                  sleep 1
        printf 'scan on\n';               sleep 20
        printf 'pair %s\n' "$ADDR";       sleep 12
        printf 'trust %s\n' "$ADDR";      sleep 2
        printf 'connect %s\n' "$ADDR";    sleep 6
        printf 'scan off\nquit\n'
    } | bluetoothctl >/dev/null 2>&1
}

# State is REPORTED, never assumed: 'playing' versus 'connected' is the whole
# lesson of [PI3-WHY-010], and the only honest source for it is what the
# system says right now.
state_of() {
    local info paired trusted connected bonded has_bonded
    info="$(bluetoothctl info "$1" 2>/dev/null)" || true
    [ -z "$info" ] && { echo "found"; return; }
    paired=$(grep -c 'Paired: yes' <<<"$info")
    trusted=$(grep -c 'Trusted: yes' <<<"$info")
    connected=$(grep -c 'Connected: yes' <<<"$info")
    bonded=$(grep -c 'Bonded: yes' <<<"$info")
    has_bonded=$(grep -c 'Bonded:' <<<"$info")

    # 'Paired: yes' is not proof of a pairing. A leftover record makes BlueZ
    # answer AlreadyExists and skip the bonding exchange entirely, leaving
    # Paired: yes beside Bonded: no -- no link key was ever stored, and the
    # link dies at the first disconnect looking exactly like interference.
    # The link key is the thing that has to exist, so where BlueZ will tell
    # us about it, that is what is believed. Older builds omit the field, and
    # there Paired is the best available answer.
    [ "$has_bonded" -gt 0 ] && paired="$bonded"

    if   [ "$connected" -gt 0 ] && [ "$paired" -gt 0 ]; then echo "connected"
    elif [ "$paired" -gt 0 ];                          then echo "paired"
    elif [ "$trusted" -gt 0 ] || [ "$connected" -gt 0 ]; then echo "stale"  # [PI3-WHY-050]
    else echo "found"
    fi
}

# `ok` reports the OUTCOME, never that the helper managed to run. That
# distinction is not pedantry: `repair` once returned ok:true beside
# state:"found", having destroyed a working pairing and failed to make a new
# one, and the true half of that answer was ignored because the other half
# said success.
#
#   report STATE "ACCEPTED STATES" [EXTRA_JSON]
report() {
    local st="$1" accepted="$2" extra="${3:-}" ok=false
    case " $accepted " in *" $st "*) ok=true ;; esac
    printf '{"ok":%s,"state":"%s"%s}\n' "$ok" "$st" "$extra"
    [ "$ok" = true ] || exit 1
}

json_devices() {
    local first=1 mac name
    printf '{"ok":true,"devices":['
    while read -r _ mac name; do
        [[ "$mac" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || continue
        [ $first -eq 1 ] || printf ','
        first=0
        printf '{"address":"%s","name":"%s","state":"%s"}' \
               "$mac" "${name//\"/}" "$(state_of "$mac")"
    done < <(bluetoothctl devices 2>/dev/null)
    printf ']}\n'
}

case "$VERB" in
    list)
        json_devices
        ;;
    scan)
        # Bounded. A permanently scanning radio is a permanently degraded one
        # on an antenna shared with Wi-Fi [PI3-UI-040].
        { printf 'power on\n'; sleep 1
          printf 'scan on\n';  sleep "${SCAN_SECONDS:-20}"
          printf 'scan off\nquit\n'; } | bluetoothctl >/dev/null 2>&1
        json_devices
        ;;
    pair)
        need_addr
        pair_sequence
        report "$(state_of "$ADDR")" "connected paired"
        ;;
    repair)
        # A trusted-but-not-paired record makes every pair attempt fail with
        # no explanation, and clearing it is the fix nobody would guess. But
        # the clearing came FIRST here, which meant a repair that could not
        # re-pair left the speaker worse than it found it -- no record at all,
        # and no way back without someone physically holding the button.
        #
        # So: try plainly first, and remove only once a plain attempt has
        # actually failed. Nothing working is destroyed on the strength of a
        # guess about why.
        need_addr
        pair_sequence
        st="$(state_of "$ADDR")"
        case "$st" in
            connected|paired) ;;
            *)
                bluetoothctl remove "$ADDR" >/dev/null 2>&1
                sleep 2
                pair_sequence
                st="$(state_of "$ADDR")"
                ;;
        esac
        report "$st" "connected paired"
        ;;
    use)
        need_addr
        bluetoothctl trust "$ADDR"   >/dev/null 2>&1
        bluetoothctl connect "$ADDR" >/dev/null 2>&1
        sleep 5
        # Make it the default sink. The caller must still reopen the player's
        # output: the stream does not dependably follow [PI3-WHY-020].
        node="$(sudo -u "${SUDO_USER:-$USER}" \
                XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" wpctl status 2>/dev/null \
                | sed -n '/Sinks:/,/Sink endpoints/p' \
                | grep -iv 'Dummy Output' | grep -oE '[0-9]+\.' | head -1 | tr -d '.')"
        [ -n "$node" ] && sudo -u "${SUDO_USER:-$USER}" \
            XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" wpctl set-default "$node" 2>/dev/null
        report "$(state_of "$ADDR")" "connected" \
               ",\"sink_node\":\"${node:-none}\""
        ;;
    forget)
        need_addr
        bluetoothctl disconnect "$ADDR" >/dev/null 2>&1
        bluetoothctl remove "$ADDR"     >/dev/null 2>&1
        # 'found' is what state_of says when no record remains, which for this
        # verb is the success it was asked for.
        report "$(state_of "$ADDR")" "found"
        ;;
    status)
        # A query's ok means only that it could answer, which is the whole of
        # what it promised. The state field carries everything else.
        need_addr
        printf '{"ok":true,"state":"%s"}\n' "$(state_of "$ADDR")"
        ;;
    *)
        die "unknown verb"
        ;;
esac
