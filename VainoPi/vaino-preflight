#!/bin/sh
# Say what this appliance is about to start with, before it starts.
#
# **`[PI-PRE-010]` Why a boot needs this at all.** `vaino-db-recover` is what
# stands between a power cut and a crash loop `[PI3-FOUND-120]`, and it works
# by shelling out to `sqlite3`. It is also, deliberately, never fatal: a
# database it cannot open is reported and the start continues, because a
# player that starts and complains is better than one that refuses. Those two
# properties combine badly. If the command it depends on is ever missing, the
# script prints one line about failing to open a database and exits 0, and
# recovery silently stops happening -- with nothing in the log distinguishing
# "this database is broken" from "the tool that repairs it is gone". The next
# power cut is then the crash loop again, months after the change that caused
# it.
#
# An instrument that cannot say whether it is armed is not an instrument. This
# runs first, names every tool the startup path needs, gives its version, and
# states what is lost if it is absent.
#
# **`[PI-PRE-020]` It never blocks a start.** Exit is always 0. Nothing here
# is a gate -- the appliance's job is to play music, and refusing to boot
# because a diagnostic helper is missing would be the failure this is meant to
# prevent, not a defence against it. The output is the whole product.
#
# **`[PI-PRE-050]` It asks the machine, not a list.** Which tools matter
# depends on which appliance this is, and hard-coding that means two lists to
# keep in step. Instead the audio-path tools are reported only when
# `vaino-wait-sink` is installed, since that script is the only thing in the
# startup path that uses them: `vainopi` has it and `bose` does not, and
# neither had to be named here to get the right answer.
set -u

BIN="${VAINO_BIN:-/usr/local/bin/vaino}"
WAIT_SINK="${VAINO_WAIT_SINK:-/usr/local/bin/vaino-wait-sink}"

say() { echo "vaino-preflight: $*"; }
warn() { echo "vaino-preflight: $*" >&2; }

# `command -v` and not `which`: a builtin, always present, and it does not
# depend on a package this is checking for the absence of.
have() { command -v "$1" >/dev/null 2>&1; }

# One line per tool, and the version is the point of it. "sqlite3 present" ages
# into uselessness the moment a version difference matters; `3.40.1` beside
# another appliance's `3.46.1` is a fact you can act on.
#
# The version string is produced by the CALLER and passed in, because no two
# of these tools agree on how to be asked. `sqlite3 --version` leads with the
# number; `bluetoothctl --version` trails it; `wpctl` has no version option at
# all and has to be asked through `wireplumber`. Guessing a uniform form is
# how `wpctl Usage:` ends up in a boot log, which is what the first draft of
# this did.
report() {
    _name="$1"
    _ver="$2"
    have "$_name" || return 1
    say "$_name ${_ver:-(version not reported)} at $(command -v "$_name")"
}

# ---------------------------------------------------------------- the player
#
# `vaino --version` prints its own commit, which is the single most useful
# line in a boot log: it answers "what is actually running here" without an
# ssh session, and it is the question every remote diagnosis starts with.
if [ -x "$BIN" ]; then
    say "$("$BIN" --version 2>&1 | head -1) at $BIN"
else
    warn "player binary MISSING at $BIN -- this start will fail"
fi

# --------------------------------------------------------------- recovery
#
# The two runners are genuinely interchangeable here, which was measured
# rather than assumed `[PI-PRE-040]`: against a WAL database with
# un-checkpointed frames and against a hot rollback journal whose pages had
# really reached the database file, `python3` and `sqlite3` produced identical
# results -- frames replayed, journal rolled back and deleted.
RECOVERY=""

if report sqlite3 "$(sqlite3 --version 2>/dev/null | awk '{print $1}')"; then
    RECOVERY=sqlite3
else
    warn "sqlite3 ABSENT -- recovery will fall back to python3, which is"
    warn "  equivalent for that one act [PI-PRE-030]. Every Sampo tool that"
    warn "  reaches this host over ssh still expects the command, and reports"
    warn "  the appliance unreachable without it [BOS-IMG-020]."
fi

if report python3 "$(python3 -c 'import sqlite3, sys; print("%s (sqlite module %s)" % (sys.version.split()[0], sqlite3.sqlite_version))' 2>/dev/null)"; then
    [ -n "$RECOVERY" ] || RECOVERY="python3 (fallback)"
else
    warn "python3 ABSENT"
fi

if [ -n "$RECOVERY" ]; then
    say "database recovery armed via $RECOVERY"
else
    warn "database recovery UNAVAILABLE: neither sqlite3 nor python3 is"
    warn "  installed. An unclean stop will NOT be repaired at boot, and the"
    warn "  next power cut is a crash loop [PI3-FOUND-120]. Install either."
fi

# ------------------------------------------------------------- audio path
#
# Reported only where something in the startup path uses them; see
# `[PI-PRE-050]`. Absence is a warning and never more than that -- `wait-sink`
# is bounded and exits 0 whatever it finds, so a missing tool here costs the
# speaker wait, not the boot.
if [ -x "$WAIT_SINK" ]; then
    # `wpctl` takes no version option; the number belongs to WirePlumber, which
    # is the thing that would actually differ between two images.
    _wp="$(wireplumber --version 2>/dev/null |
        sed -n 's/^Linked with libwireplumber //p')"
    [ -n "$_wp" ] && _wp="(wireplumber $_wp)"
    report wpctl "$_wp" || {
        warn "wpctl ABSENT -- no sink can be detected, so vaino-wait-sink waits"
        warn "  out its deadline and starts the player anyway. Audio will go"
        warn "  nowhere until a sink appears."
    }
    report bluetoothctl "$(bluetoothctl --version 2>/dev/null | awk '{print $NF}')" || {
        warn "bluetoothctl ABSENT -- the listener's chosen speaker cannot be"
        warn "  named, so the sink wait accepts whichever real sink appears"
        warn "  first [PI3-FOUND-280]."
    }
fi

exit 0
