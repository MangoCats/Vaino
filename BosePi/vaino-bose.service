#
# vaino's unit on bose. Installed by finalize-bose.sh --start.
#
# Not After=network-online.target: audio must start without waiting for the
# network, same reasoning as IMPL001's unit for vainopi. bose's MPD guest is
# local (127.0.0.1), so no Bluetooth-style settle wait applies here either
# [IMPL-BOS-030].
[Unit]
Description=Vaino
After=sound.target mpd.service
Wants=sound.target
Requires=mpd.service

[Service]
Type=simple
# Positional <vaino.db>, not --db: the actual CLI [player/src/bin/vaino.rs],
# not the --db/--music/--output form an earlier IMPL001 template showed --
# corrected there 2026-09-06.
#
# --device hifiberry is load-bearing, found missing the first time this
# actually ran: with no --device, vaino opened ALSA's first enumerated
# device, which on this image's card order is `card 0: bcm2835 Headphones`
# (the Pi's own onboard jack, nothing connected) -- not
# `card 2: sndrpihifiberry`, the real DAC. BOSE001's survey found the
# HiFiBerry as card 1 on the old 32-bit install; this Bookworm/trixie image
# orders it differently. Played perfectly, reported healthy, silent --
# [IMPL-AUD-010]'s dummy-output hazard, in a different shape.
#
# Split since 2026-09-11 [BOS-RUN-080]: the listener half is the positional
# argument and the catalogue is named with --library. /srv/library is `ro` in
# normal operation, which is why the catalogue goes there and why
# vaino-db-recover cannot repair it in place [BOS-RUN-090].
#
# vaino-preflight runs first and repairs nothing -- it reports which tools are
# present, with versions, so the log says whether recovery is armed
# [PI-PRE-010]. vaino-db-recover then does the one read-write open that
# replays a WAL or rolls back a journal [PI3-FOUND-120]. No vaino-wait-sink
# here: that waits on PipeWire, and this machine goes straight to ALSA.
ExecStartPre=/usr/local/bin/vaino-preflight
ExecStartPre=/usr/local/bin/vaino-db-recover
ExecStart=/usr/local/bin/vaino /var/vaino/listener.db --library /srv/library/library.db --device hifiberry --mpd 127.0.0.1:6600 --mpd-root /srv/library/audio
Restart=always
RestartSec=2
User=pi
Nice=-5
MemoryMax=200M

[Install]
WantedBy=multi-user.target
