FROM rust:1.90-bookworm
# autoconf/automake/libtool: only needed to cross-compile with `--features
# sonos` -- `mp3lame-sys` vendors LAME's own C source and drives its
# autotools build itself, correctly passing --host for the target triple,
# but assumes these are already on the machine running it [Sonos/SONOS006].
RUN dpkg --add-architecture arm64 && apt-get update && apt-get install -y \
      gcc-aarch64-linux-gnu libasound2-dev:arm64 pkg-config \
      autoconf automake libtool && \
    rustup target add aarch64-unknown-linux-gnu
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig
WORKDIR /w
